<?xml version="1.0" encoding="utf-8"?>
<!--
  Generates version.gen.h in the intermediate directory, from version.info (major/minor/patch) and the git commit, for
  the resource script (VERSIONINFO) and the code (first log message). Import it from a project, after
  Microsoft.Cpp.targets.

  The header is only rewritten when its content changes, so that the files including it are not rebuilt every time.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VersionInfoFile>$(MSBuildThisFileDirectory)version.info</VersionInfoFile>
    <VersionHeaderFile>$(IntDir)version.gen.h</VersionHeaderFile>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <Target Name="GenerateVersionHeader" BeforeTargets="ClCompile;ResourceCompile" AfterTargets="PrepareForBuild">
    <PropertyGroup>
      <_VersionInfo>$([System.IO.File]::ReadAllText('$(VersionInfoFile)'))</_VersionInfo>
      <VersionMajor>$([System.Text.RegularExpressions.Regex]::Match($(_VersionInfo), `major=(\d+)`).Groups[1].Value)</VersionMajor>
      <VersionMinor>$([System.Text.RegularExpressions.Regex]::Match($(_VersionInfo), `minor=(\d+)`).Groups[1].Value)</VersionMinor>
      <VersionPatch>$([System.Text.RegularExpressions.Regex]::Match($(_VersionInfo), `patch=(\d+)`).Groups[1].Value)</VersionPatch>
    </PropertyGroup>
    <Error Condition="'$(VersionMajor)' == '' Or '$(VersionMinor)' == '' Or '$(VersionPatch)' == ''"
           Text="$(VersionInfoFile) must define major, minor and patch." />

    <!-- The commit is optional (for example when building from a source archive). -->
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup>
      <VersionCommit Condition="'$(_GitExitCode)' == '0'">$(_GitCommit.Trim())</VersionCommit>
      <VersionCommit Condition="'$(VersionCommit)' == ''">unknown</VersionCommit>
    </PropertyGroup>

    <ItemGroup>
      <_VersionHeaderLine Include="// Generated by version.targets from version.info and the git commit. Do not edit." />
      <_VersionHeaderLine Include="#pragma once" />
      <_VersionHeaderLine Include="#define VERSION_MAJOR $(VersionMajor)" />
      <_VersionHeaderLine Include="#define VERSION_MINOR $(VersionMinor)" />
      <_VersionHeaderLine Include="#define VERSION_PATCH $(VersionPatch)" />
      <_VersionHeaderLine Include="#define VERSION_STRING &quot;$(VersionMajor).$(VersionMinor).$(VersionPatch)&quot;" />
      <_VersionHeaderLine Include="#define VERSION_COMMIT &quot;$(VersionCommit)&quot;" />
    </ItemGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(VersionHeaderFile)" Lines="@(_VersionHeaderLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Text="Version $(VersionMajor).$(VersionMinor).$(VersionPatch) ($(VersionCommit))" Importance="normal" />
  </Target>
</Project>
